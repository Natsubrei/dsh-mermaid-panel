{
  "name": "dsh-mermaid-panel",
  "version": "0.1.5",
  "type": "module",
  "description": "Mermaid diagrams in the DeepSeek Harness right sidebar. The page renders the open conversation; zoom and pan are in the full-screen view.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "mermaid",
    "diagram",
    "sidebar"
  ],
  "author": "Natsubrei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natsubrei/dsh-mermaid-panel.git"
  },
  "homepage": "https://github.com/Natsubrei/dsh-mermaid-panel#readme",
  "bugs": {
    "url": "https://github.com/Natsubrei/dsh-mermaid-panel/issues"
  },
  "engines": {
    "dsh": "*"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.mermaid.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test src/*.test.mjs",
    "market": "node scripts/market-index.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "mermaid": "11.17.2"
  }
}
